# Every variable is optional; the defaults are in src/evilflowers_scan/settings.py and evilflowers-worker's
# settings.py (broker, delivery semantics, storage, logs) and judges/settings.py (decider-vision).

# The digitalizer's Redis db; its callback queue must be on the same db.
REDIS_URL=redis://redis:6379/8
SCAN_QUEUE=evilflowers_scan.standalone
SCAN_INTERACTIVE_QUEUE=evilflowers_scan.standalone.interactive
# Seconds before Redis redelivers an unacknowledged job. One value for every consumer of the db (12 h).
BROKER_VISIBILITY_TIMEOUT=43200
WORKER_SOFT_SHUTDOWN_TIMEOUT=60
WORKER_CANCEL_TIMEOUT=30
MAX_DELIVERIES=5
# raw-scans/ (read only) and the items' _studio/jobs/ directories, as the orchestrator names them.
STORAGE_PATH=/mnt/data

# A job of 32 leaves must end under the orchestrator's deadline (clean: 3600 s). Past the soft limit the job writes a
# failed outcome; the hard limit kills it 60 s later.
TASK_SOFT_TIME_LIMIT=3240
TASK_TIME_LIMIT=3300

# ScanTailor
SCANTAILOR_BINARY=scantailor-deviant-cli
COLOR_MODE=mixed
DESPECKLE=cautious
MARGINS_MM=8
DEWARPING=auto
NORMALIZE_ILLUMINATION=1
DPI=300
OUTPUT_DPI=600

# DocRes (appearance) on color_grayscale leaves; the venv and weights on the /models PVC
DOCRES_ENABLED=0
DOCRES_REPO=/models/DocRes
DOCRES_PYTHON=/models/venv-docres/bin/python
DOCRES_TASK=appearance

# Renditions
PREVIEW_PX=1600
WEBP_QUALITY=80
DZI_TILE=254

# Artefact check (#2): signals, then decider-vision for the uncertain band only
ARTEFACTS_ENABLED=1
ARTEFACT_SURE=0.85
ARTEFACT_FLOOR=0.35
ARTEFACT_MIN_REPEATS=3
JUDGES_ENABLED=0
DECIDER_VISION_URL=http://decider-vision.shared.svc.cluster.local
DECIDER_VISION_REVISION=
# Measured in knowledge#65; without them a judged mark is `review`.
JUDGE_THRESHOLDS={"scan_mark": {"keep": 0.8, "hide": 0.9}}
JUDGE_BUDGET_CALLS=500
JUDGE_BUDGET_SECONDS=900

# Logs: json (one object per line; what Loki parses) or text
LOG_FORMAT=json

# Telemetry. Off when neither an OTLP endpoint nor HOST_IP is set (evilflowers-knowledge Cookbooks/Deploy-a-Service §3).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://<alloy>:4318
# OTEL_SERVICE_NAME=scan
